{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a11ydevs:acessilia-dataset:input-manifest:1.1.0",
  "title": "Acessilia Dataset input manifest row",
  "description": "JSON Schema for one row of input/manifest.csv. All CSV values are strings.",
  "x-manifest-schema-version": "1.1.0",
  "x-csv-columns": [
    "id",
    "original_filename",
    "format",
    "media_type",
    "byte_size",
    "pages",
    "language",
    "domain",
    "subdirectory",
    "tables",
    "formulas",
    "images",
    "callouts",
    "chapters",
    "notes",
    "input_path",
    "family_id",
    "derived_from",
    "source_origin",
    "source_creator",
    "source_url",
    "license_status",
    "license_summary",
    "license_reference",
    "redistribution_status",
    "source_evidence"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "original_filename",
    "format",
    "media_type",
    "byte_size",
    "pages",
    "language",
    "domain",
    "subdirectory",
    "tables",
    "formulas",
    "images",
    "callouts",
    "chapters",
    "notes",
    "input_path",
    "family_id",
    "derived_from",
    "source_origin",
    "source_creator",
    "source_url",
    "license_status",
    "license_summary",
    "license_reference",
    "redistribution_status",
    "source_evidence"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{3}$"},
    "original_filename": {"type": "string", "minLength": 1},
    "format": {"enum": ["pdf", "image"]},
    "media_type": {"type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$"},
    "byte_size": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "pages": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "language": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "subdirectory": {"type": "string"},
    "tables": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "formulas": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "images": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "callouts": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "chapters": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "notes": {"type": "string"},
    "input_path": {"type": "string", "pattern": "^input/[A-Za-z0-9._/-]+$"},
    "family_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "derived_from": {"type": "string", "pattern": "^(|[0-9]{3})$"},
    "source_origin": {"type": "string", "minLength": 1},
    "source_creator": {"type": "string", "minLength": 1},
    "source_url": {
      "type": "string",
      "anyOf": [{"const": ""}, {"format": "uri"}]
    },
    "license_status": {
      "enum": [
        "restricted",
        "unknown",
        "inherited_unknown",
        "service_terms_reviewed",
        "inherited_from_parent",
        "project_mit",
        "documented_limited_permission"
      ]
    },
    "license_summary": {"type": "string", "minLength": 1},
    "license_reference": {"type": "string", "minLength": 1},
    "redistribution_status": {
      "enum": [
        "permission_required",
        "review_required",
        "inherited_from_parent",
        "permitted_under_service_output_terms",
        "permitted_under_mit",
        "permitted_for_repository_test_only"
      ]
    },
    "source_evidence": {"type": "string", "minLength": 1}
  }
}
