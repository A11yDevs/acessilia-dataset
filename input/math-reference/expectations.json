{
  "manifest_id": "036",
  "description": "Checks on the accessible outputs of velocidade-instantanea.pdf that the formula ground truth (ground_truth.csv) does not cover: repaired text, document structure and formula speech. Patterns are Python regular expressions applied to the plain-text output (TXT, or text extracted from the PDF/UA) unless 'target' says otherwise. They target the artifacts of the Acessilia pipeline's extraction (Docling through the Toolbox's document.structure.extract), which keeps TeX spacing accents, split ligatures and a detached U+0338 for ≠; a different extractor shows other artifacts (pdftotext composes accents and ligatures but prints ≠ as '6='), so the checks are meant for the pipeline's outputs, not for an arbitrary text extraction of the PDF.",
  "text": {
    "must_match": [
      {
        "id": "header-university",
        "pattern": "Universidade de Brasília",
        "why": "dotless i + acute in the TeX text layer"
      },
      {
        "id": "header-department",
        "pattern": "Departamento de Matemática"
      },
      {
        "id": "title",
        "pattern": "Cálculo 1"
      },
      {
        "id": "subtitle",
        "pattern": "O problema da velocidade instantânea"
      },
      {
        "id": "crase-medida",
        "pattern": "à medida",
        "why": "TeX grave accent (\\`a) extracts as a spacing ‘ or ` before the letter"
      },
      {
        "id": "crase-exaustao",
        "pattern": "à exaustão"
      },
      {
        "id": "ligature-fica",
        "pattern": "fica próximo",
        "why": "the fi ligature extracts as 'fi ca'"
      },
      {
        "id": "not-equal",
        "pattern": "≠|\\\\neq?\\b|diferente de",
        "why": "h ≠ 0 appears five times; losing the slash inverts the meaning"
      },
      {
        "id": "negative-velocity",
        "pattern": "(?:[−-]|menos)\\s?0\\s?,\\s?0833",
        "why": "table cell; the sign carries the meaning, as a character or spoken (the TXT reads cell math: 'menos 0,0833')"
      }
    ],
    "must_not_match": [
      {
        "id": "spacing-accent",
        "pattern": "[´˜¸ˆ]\\s?[A-Za-zıȷ]",
        "why": "unrepaired TeX spacing accent"
      },
      {
        "id": "spacing-grave",
        "pattern": "[‘`]\\s?a\\b",
        "why": "unrepaired TeX grave accent"
      },
      {
        "id": "orphan-negation",
        "pattern": "(?<![=<>∈⊂≤≥∼≡])\\u0338",
        "why": "a combining long solidus that did not compose into ≠"
      },
      {
        "id": "split-ligature",
        "pattern": "\\bfi ca\\b"
      },
      {
        "id": "six-equals",
        "pattern": "\\b6\\s?=",
        "why": "≠ drawn as the glyphs '6' and '=' (the form pdftotext gives); the body has no legitimate '6='"
      }
    ]
  },
