      }
    ],
    "tables": "'table' rows describe semantic data rows (excluding captions), columns and the presence of semantic column headers (header=0 or 1). A styled group title is a caption, not a column header; legacy IDs ending in -h may have been reclassified. See audit.table_semantics.",
    "chemical_structures_are_descriptions": {
      "pages": [
        25,
        26,
        30,
        37
      ],
      "why": "a drawn molecule must be a described picture, never a formula block (#284)"
    },
    "slides_of_text_as_a_picture": {
      "pages": [
        41
      ],
      "why": "a slide replaced by one picture of the whole slide must keep its text when the description fails (replaced_text)"
    }
  },
  "degraded": {
    "description": "Content preservation remains required when the vision provider fails, including literal text embedded in raster images. The text kind is a content role, not proof of a native text layer; provenance is in audit.provenance and source= notes. Such a run must not be cached.",
    "text_ids_always_present": "every ground_truth.csv row of kind 'text'",
    "not_cacheable": true
  },
