{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a11ydevs:acessilia-dataset:references-manifest:1.2.0",
  "title": "Acessilia Dataset references manifest row",
  "description": "JSON Schema for one row of references/manifest.csv. schema_version identifies this coverage-manifest schema; content_schema identifies the JSON Schema for the referenced file.",
  "x-manifest-schema-version": "1.2.0",
  "x-csv-columns": [
    "input_id",
    "task",
    "availability",
    "coverage_scope",
    "annotated_count",
    "eligible_count",
    "coverage_unit",
    "review_state",
    "reviewer",
    "reviewed_at",
    "provenance",
    "annotation_revision",
    "reference_type",
    "format",
    "schema_version",
    "content_schema",
    "file_path",
    "record_selector",
    "notes"
  ],
  "$defs": {
    "recordSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "filters", "count_mode"],
          "properties": {
            "type": {"const": "csv_filter"},
            "filters": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "string", "minLength": 1}
            },
            "count_mode": {"const": "rows"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "pointers", "count_mode"],
          "properties": {
            "type": {"const": "json_pointers"},
            "pointers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^/"}
            },
            "count_mode": {"enum": ["items", "rules", "units"]}
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_id",
    "task",
    "availability",
    "coverage_scope",
    "annotated_count",
    "eligible_count",
    "coverage_unit",
    "review_state",
    "reviewer",
    "reviewed_at",
    "provenance",
    "annotation_revision",
    "reference_type",
    "format",
    "schema_version",
    "content_schema",
    "file_path",
    "record_selector",
    "notes"
  ],
  "properties": {
    "input_id": {"type": "string", "pattern": "^[0-9]{3}$"},
    "task": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "availability": {"enum": ["complete", "partial", "unannotated"]},
    "coverage_scope": {"type": "string", "minLength": 1},
    "annotated_count": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "eligible_count": {"type": "string", "pattern": "^(|0|[1-9][0-9]*)$"},
    "coverage_unit": {"enum": ["output_file", "fixture", "check", "formula", "assertion"]},
    "review_state": {"enum": ["reviewed", "not_reviewed", "not_recorded", "not_applicable"]},
    "reviewer": {"type": "string"},
    "reviewed_at": {"type": "string", "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$"},
    "provenance": {"type": "string", "minLength": 1},
    "annotation_revision": {"type": "string", "pattern": "^(|[1-9][0-9]*)$"},
    "reference_type": {"enum": ["ground_truth", "expectations", "expected_output"]},
    "format": {"enum": ["csv", "json", "txt", "html", "pdf", "pdf_ua", "mp3", "epub"]},
    "schema_version": {"const": "1.2.0"},
    "content_schema": {"type": "string"},
    "file_path": {"type": "string"},
    "record_selector": {"type": "string"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"availability": {"const": "unannotated"}},
        "required": ["availability"]
      },
      "then": {
        "properties": {
          "annotated_count": {"const": "0"},
          "file_path": {"const": ""},
          "content_schema": {"const": ""},
          "record_selector": {"const": ""},
          "annotation_revision": {"const": ""},
          "review_state": {"const": "not_applicable"}
        }
      },
      "else": {
        "properties": {
          "annotated_count": {"pattern": "^[1-9][0-9]*$"},
          "file_path": {"pattern": "^references/[A-Za-z0-9._/-]+$"},
          "content_schema": {"pattern": "^references/[A-Za-z0-9._/-]+[.]schema[.]json$"},
          "record_selector": {"minLength": 2},
          "annotation_revision": {"pattern": "^[1-9][0-9]*$"}
        }
      }
    },
    {
      "if": {
        "properties": {"availability": {"const": "complete"}},
        "required": ["availability"]
      },
      "then": {
        "properties": {"eligible_count": {"pattern": "^[1-9][0-9]*$"}}
      }
    },
    {
      "if": {
        "properties": {"review_state": {"const": "reviewed"}},
        "required": ["review_state"]
      },
      "then": {
        "properties": {
          "reviewer": {"minLength": 1},
          "reviewed_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    }
  ]
}
